{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "1to50-game",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-data",
      "database_id": "ff27b9a0-e9b8-484e-b6cb-d04d2c601ed8",
      "migrations_dir": "migrations",
      "migrations_table": "one_to_fifty_migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "1to50.game.foxtang.com",
      "custom_domain": true
    }
  ]
}
